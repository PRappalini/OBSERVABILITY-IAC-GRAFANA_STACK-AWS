#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
mkdir -p /opt/observability/data /opt/observability/tempo
chown -R 10001:10001 /opt/observability/data
chmod 750 /opt/observability/data
echo '${compose_file}' | base64 -d > /opt/observability/docker-compose.yml
echo '${tempo_config}' | base64 -d > /opt/observability/tempo/tempo.yml
cd /opt/observability
docker compose up -d
